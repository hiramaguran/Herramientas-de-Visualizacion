		sortByColumn: 'Día Semana Num'

		annotation SummarizationSetBy = Automatic

	column 'AñoMes Num' = YEAR(Calendario[Date]) * 100 + MONTH(Calendario[Date])
		formatString: 0
		lineageTag: 55c4e954-f84e-4f3d-83af-29ad6d0e1123
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(YEAR(MIN(ventas[Fecha])), MONTH(MIN(ventas[Fecha])), 1),
				        EOMONTH(MAX(ventas[Fecha]), 0)
				    ),
				    "Año", YEAR([Date]),
				    "Mes Num", MONTH([Date]),
				    "Mes", FORMAT([Date], "mmm yyyy"),
				    "Día Semana Num", WEEKDAY([Date], 2),
				    "Día Semana", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = eb9c64a8dc30405f9536fe8b9b919671

